# Runtime
MODE=paper
EXCHANGE=okx
SYMBOL=BTCUSDT
INTERVAL=5m
STRATEGY=moe_v2_enhanced
STRATEGY_PARAMS={}

# Exchange credentials (OKX)
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase
OKX_USE_SIMULATED_TRADING=1

# Exchange credentials (Binance - optional)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# MOE settings
MOE_MODEL_PATH=models/dynamic_moe_v2_enhanced_final.pkl
MOE_PROBA_THRESHOLD=0.35
MOE_USE_REGIME_SPECIFIC=false
MOE_USE_DYNAMIC_THRESHOLD=true
MOE_USE_QUANTILE_THRESHOLD=true
MOE_TARGET_SIGNAL_RATE=0.08
MOE_QUANTILE_WINDOW=400
MOE_QUANTILE_FLOOR=0.55

# Risk
RISK_PER_TRADE=0.10
SL_PCT=0.02
TP_PCT=0.04
TRAILING_PCT=0
SL_ATR_K=0
TP_ATR_K=0
TRAILING_ATR_K=0
MAX_POSITION_SIZE=0
MAX_DCA_ORDERS=1

# Loop control
HISTORY_LIMIT=120
COOL_DOWN_SEC=300
CHECK_INTERVAL_SEC=30

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
